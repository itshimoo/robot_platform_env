# =============================================================================
# Robot Platform Environment Configuration Example
# =============================================================================
# Copy this file to platform.env and customize for your robot platform.
# This example shows all available configuration options.

# =============================================================================
# ROBOT IDENTITY
# =============================================================================
# Basic robot identification
ROBOT_NAME=my_robot
ROBOT_TYPE=mobile_robot
ROBOT_DESCRIPTION="My custom robot setup"

# =============================================================================
# ROS CONFIGURATION
# =============================================================================
# ROS distribution and workspace settings
ROS_DISTRO=noetic                    # Options: noetic, melodic, humble
ROS_WORKSPACE=/workspace             # Path to ROS workspace inside container
ROS_PACKAGES=navigation,slam,perception  # Comma-separated list of ROS packages

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================
# Docker image and container settings
DOCKER_IMAGE_NAME=robotlab-ros       # Docker image name (local or registry)
# Alternative: DOCKER_IMAGE_NAME=ghcr.io/username/robot_platform_env
DOCKER_CONTAINER_NAME=robotlab-container
DOCKER_TAG=latest                    # Image tag: latest, v1.0, etc.
DOCKER_PORT=8080                     # Port mapping for web services
WORKSPACE_PATH=/workspace            # Workspace path inside container

# =============================================================================
# HARDWARE CONFIGURATION
# =============================================================================
# Robot hardware capabilities
HAS_CAMERA=true                      # Enable camera support
HAS_LIDAR=true                       # Enable LiDAR support
MOTOR_COUNT=4                        # Number of motors
SENSORS=imu,gps,encoder              # Comma-separated sensor list

# =============================================================================
# CLI CONFIGURATION
# =============================================================================
# Command-line interface settings
CLI_COMMAND=xr                       # CLI command name (xr, robotlab, etc.)

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Development and runtime options
GUI_ENABLED=true                     # Enable GUI applications (RViz, Gazebo)
DEBUG_MODE=false                     # Enable debug logging
AUTO_START=false                     # Auto-start container on boot
GPU_ENABLED=true                     # Enable GPU support for AI workloads

# =============================================================================
# ADVANCED SETTINGS (Optional)
# =============================================================================
# Uncomment and modify these as needed:

# ROS_MASTER_URI=http://localhost:11311
# ROS_IP=127.0.0.1
# ROS_HOSTNAME=localhost

# Additional Docker options
# DOCKER_VOLUME_PATH=/path/to/host/workspace
# DOCKER_NETWORK=robotlab-network

# Container resource limits
# DOCKER_MEMORY_LIMIT=4g
# DOCKER_CPU_LIMIT=2

# Security settings
# DOCKER_USER=robotlab
# DOCKER_GROUP=robotlab 