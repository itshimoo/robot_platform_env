# Robot Platform Environment Configuration Example
# Copy this file to platform.env and customize for your robot platform

# Robot Identity
ROBOT_NAME=my_robot
ROBOT_TYPE=mobile_robot
ROBOT_DESCRIPTION=My custom robot setup

# ROS Configuration
ROS_DISTRO=noetic
ROS_WORKSPACE=/workspace
ROS_PACKAGES=navigation,slam,perception

# Docker Settings
DOCKER_IMAGE=my_robot_ros
DOCKER_CONTAINER=my_robot_container
DOCKER_PORT=8080

# Hardware Configuration
HAS_CAMERA=true
HAS_LIDAR=true
MOTOR_COUNT=4
SENSORS=imu,gps,encoder

# CLI Configuration
CLI_COMMAND=rpe

# Development Settings
GUI_ENABLED=true
DEBUG_MODE=false
AUTO_START=false 